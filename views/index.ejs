<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sorhy Bot User Data</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🤖 Sorhy Bot User Data</h1>
            <div class="subtitle">User messages & interactions</div>
        </div>

        <div class="stats">
            <div class="stat-card">
                <div class="stat-number" id="totalUsers">-</div>
                <div class="stat-label">Total Users</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" id="totalMessages">-</div>
                <div class="stat-label">Total Messages</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" id="totalErrors">-</div>
                <div class="stat-label">Total Errors</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" id="lastUpdate">-</div>
                <div class="stat-label">Last Update</div>
            </div>
        </div>

        <div class="controls">
            <input type="text" class="search-box" id="searchBox" placeholder="🔍 Search users or messages...">
            <button class="btn btn-primary" onclick="loadUserData()">
                🔄 Refresh
            </button>
            <button class="btn btn-secondary expand-all-btn" id="expandAllBtn" onclick="toggleAllSections()">
                📂 Expand All
            </button>
            <a href="/admin/users/export?key=<%= accessKey %>" class="btn btn-success">
                💾 Export Data
            </a>
            <button class="btn btn-danger" onclick="clearAllData()">
                🗑️ Clear All
            </button>
            <div class="auto-refresh">
                <label class="toggle-switch">
                    <input type="checkbox" id="autoRefresh">
                    <span class="slider"></span>
                </label>
                Auto-refresh
            </div>
        </div>

        <div class="data-container" id="dataContainer">
            <div class="loading">Loading user data...</div>
        </div>
    </div>

    <script>
        let userData = [];
        let filteredUserData = [];
        let refreshInterval;
        let allExpanded = false;
        const accessKey = '<%= accessKey %>';

        // Load data on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadUserData();
            setupEventListeners();
        });

        function setupEventListeners() {
            // Search functionality
            document.getElementById('searchBox').addEventListener('input', function(e) {
                filterUserData(e.target.value);
            });

            // Auto-refresh toggle
            document.getElementById('autoRefresh').addEventListener('change', function(e) {
                if (e.target.checked) {
                    refreshInterval = setInterval(loadUserData, 10000); // Refresh every 10 seconds
                } else {
                    clearInterval(refreshInterval);
                }
            });
        }

        async function loadUserData() {
            try {
                showLoading();
                
                // Replace with your actual API endpoint
                const response = await fetch(`/admin/users/data?key=${accessKey}`);
                
                if (!response.ok) {
                    throw new Error('Failed to load user data');
                }
                
                const data = await response.json();
                userData = data.users || [];
                filteredUserData = [...userData];
                
                updateStats(data.stats);
                renderUserData();
            } catch (error) {
                console.error('Error loading user data:', error);
                showError('Failed to load user data');
            }
        }

        function showLoading() {
            document.getElementById('dataContainer').innerHTML = `
                <div class="loading">Loading user data...</div>
            `;
        }

        function showError(message) {
            document.getElementById('dataContainer').innerHTML = `
                <div class="no-data">❌ ${message}</div>
            `;
        }

        function updateStats(stats) {
            if (stats) {
                document.getElementById('totalUsers').textContent = stats.totalUsers || userData.length;
                document.getElementById('totalMessages').textContent = stats.totalMessages || 0;
                document.getElementById('totalErrors').textContent = stats.totalErrors || 0;
                document.getElementById('lastUpdate').textContent = new Date().toLocaleTimeString();
            } else {
                // Calculate stats from data
                const totalMessages = userData.reduce((sum, user) => sum + (user.messages?.length || 0), 0);
                const totalErrors = userData.reduce((sum, user) => 
                    sum + (user.messages?.filter(msg => msg.error).length || 0), 0);
                
                document.getElementById('totalUsers').textContent = userData.length;
                document.getElementById('totalMessages').textContent = totalMessages;
                document.getElementById('totalErrors').textContent = totalErrors;
                document.getElementById('lastUpdate').textContent = new Date().toLocaleTimeString();
            }
        }

        function renderUserData() {
            const container = document.getElementById('dataContainer');
            
            if (filteredUserData.length === 0) {
                container.innerHTML = '<div class="no-data">👤 No user data found</div>';
                return;
            }

            const usersHtml = filteredUserData.map((user, index) => {
                const userInitial = (user.username || user.id || 'U').charAt(0).toUpperCase();
                const messagesCount = user.messages?.length || 0;
                const errorsCount = user.messages?.filter(msg => msg.error).length || 0;
                
                return `
                    <div class="user-section ${allExpanded ? '' : 'collapsed'}" id="user-${index}">
                        <div class="user-header" onclick="toggleUserSection(${index})">
                            <div class="user-info">
                                <div class="user-avatar">${userInitial}</div>
                                <div class="user-details">
                                    <h3>${escapeHtml(user.username || user.id || 'Unknown User')}</h3>
                                    <div class="user-stats">
                                        ${messagesCount} messages • ${errorsCount} errors
                                        ${user.lastActivity ? `• Last: ${new Date(user.lastActivity).toLocaleString()}` : ''}
                                    </div>
                                </div>
                            </div>
                            <div class="toggle-icon">▼</div>
                        </div>
                        <div class="messages-table-container" style="display: ${allExpanded ? 'block' : 'none'}">
                            ${renderUserMessages(user.messages || [])}
                        </div>
                    </div>
                `;
            }).join('');

            container.innerHTML = usersHtml;
        }

        function renderUserMessages(messages) {
            if (!messages.length) {
                return '<div class="no-data">No messages found for this user</div>';
            }

            const messagesHtml = messages.map(msg => `
                <tr>
                    <td class="timestamp">${msg.timestamp ? new Date(msg.timestamp).toLocaleString() : 'Unknown'}</td>
                    <td class="message-cell">
                        <div class="user-message">
                            ${escapeHtml(msg.userMessage || 'No message')}
                        </div>
                    </td>
                    <td class="message-cell">
                        <div class="assistant-message">
                            ${escapeHtml(msg.assistantMessage || 'No response')}
                        </div>
                    </td>
                    <td class="message-cell">
                        ${msg.error ? `<div class="error-message">${escapeHtml(msg.error)}</div>` : '-'}
                    </td>
                </tr>
            `).join('');

            return `
                <table class="messages-table">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>User Message</th>
                            <th>Assistant Response</th>
                            <th>Error</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${messagesHtml}
                    </tbody>
                </table>
            `;
        }

        function toggleUserSection(index) {
            const section = document.getElementById(`user-${index}`);
            const container = section.querySelector('.messages-table-container');
            const isCollapsed = section.classList.contains('collapsed');
            
            if (isCollapsed) {
                section.classList.remove('collapsed');
                container.style.display = 'block';
            } else {
                section.classList.add('collapsed');
                container.style.display = 'none';
            }
        }

        function toggleAllSections() {
            allExpanded = !allExpanded;
            const btn = document.getElementById('expandAllBtn');
            btn.textContent = allExpanded ? '📁 Collapse All' : '📂 Expand All';
            
            document.querySelectorAll('.user-section').forEach((section, index) => {
                const container = section.querySelector('.messages-table-container');
                if (allExpanded) {
                    section.classList.remove('collapsed');
                    container.style.display = 'block';
                } else {
                    section.classList.add('collapsed');
                    container.style.display = 'none';
                }
            });
        }

        function filterUserData(searchTerm) {
            if (!searchTerm.trim()) {
                filteredUserData = [...userData];
            } else {
                const term = searchTerm.toLowerCase();
                filteredUserData = userData.filter(user => {
                    const userMatch = (user.username && user.username.toLowerCase().includes(term)) ||
                                    (user.id && user.id.toLowerCase().includes(term));
                    
                    const messageMatch = user.messages && user.messages.some(msg =>
                        (msg.userMessage && msg.userMessage.toLowerCase().includes(term)) ||
                        (msg.assistantMessage && msg.assistantMessage.toLowerCase().includes(term)) ||
                        (msg.error && msg.error.toLowerCase().includes(term))
                    );
                    
                    return userMatch || messageMatch;
                });
            }
            renderUserData();
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        async function clearAllData() {
            if (confirm('Ты уверен что хочешь удалить ВСЕ данные пользователей? Это нельзя будет отменить!')) {
                try {
                    const response = await fetch(`/admin/users/clear?key=${accessKey}`, {
                        method: 'POST'
                    });
                    
                    if (response.ok) {
                        userData = [];
                        filteredUserData = [];
                        renderUserData();
                        alert('Все данные успешно удалены!');
                    } else {
                        throw new Error('Failed to clear data');
                    }
                } catch (error) {
                    console.error('Error clearing data:', error);
                    alert('Не удалось удалить данные');
                }
            }
        }

        // Mock data for demo (remove this in production)
        if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
            setTimeout(() => {
                const mockData = {
                    users: [
                        {
                            id: 'user123',
                            username: 'Hanzo_dev',
                            lastActivity: new Date().toISOString(),
                            messages: [
                                {
                                    timestamp: new Date(Date.now() - 3600000).toISOString(),
                                    userMessage: 'Привет, как дела?',
                                    assistantMessage: 'Привет! Все отлично, готов помочь с кодом!',
                                    error: null
                                },
                                {
                                    timestamp: new Date(Date.now() - 1800000).toISOString(),
                                    userMessage: 'Помоги с React хуком',
                                    assistantMessage: 'Конечно! Что конкретно нужно сделать?',
                                    error: null
                                },
                                {
                                    timestamp: new Date().toISOString(),
                                    userMessage: 'Сломался useState',
                                    assistantMessage: '',
                                    error: 'API timeout after 30 seconds'
                                }
                            ]
                        },
                        {
                            id: 'user456',
                            username: 'TestUser',
                            lastActivity: new Date(Date.now() - 86400000).toISOString(),
                            messages: [
                                {
                                    timestamp: new Date(Date.now() - 86400000).toISOString(),
                                    userMessage: 'Test message',
                                    assistantMessage: 'Test response',
                                    error: null
                                }
                            ]
                        }
                    ],
                    stats: {
                        totalUsers: 2,
                        totalMessages: 4,
                        totalErrors: 1
                    }
                };
                userData = mockData.users;
                filteredUserData = [...userData];
                updateStats(mockData.stats);
                renderUserData();
            }, 1000);
        }
    </script>
</body>
</html>