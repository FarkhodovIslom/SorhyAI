# Required API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
TGBOT_API_KEY=your_telegram_bot_api_key_here
DEV_ACCESS_KEY=your_developer_access_key_here

# Optional: Custom MongoDB URI (if not using docker-compose MongoDB)
# MONGODB_URI=mongodb://localhost:27017/sorhy

# Optional: Model configurations
# MODEL_LITE=your_lite_model_here
# MODEL_PRO=your_pro_model_here
# MODEL_X=your_x_model_here

# Optional: Developer ID
# DEVELOPER_ID=1927786652

# Optional: Logging level
# LOG_LEVEL=info

# Optional: Node environment
# NODE_ENV=production
