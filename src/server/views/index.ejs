<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sorhy Bot - Logs Dashboard</title>
    <!-- Favicon -->
    <link rel="shortcut icon" href="/assets/SorhyAI_favicon.png" type="image/x-icon">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- CSS Link -->
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <h1><i class="fas fa-robot"></i> Sorhy Bot</h1>
            <p>Real-time Logs Dashboard</p>
        </div>
        
        <div class="stats-grid">
            <div class="stat-card total">
                <div class="stat-number" id="totalLogs">-</div>
                <div class="stat-label">Total Logs</div>
            </div>
            <div class="stat-card today">
                <div class="stat-number" id="todayLogs">-</div>
                <div class="stat-label">Today</div>
            </div>
            <div class="stat-card users">
                <div class="stat-number" id="activeUsers">-</div>
                <div class="stat-label">Active Users</div>
            </div>
        </div>
        
        <div class="controls">
            <div>
                <button class="btn btn-primary" onclick="refreshLogs()">
                    <i class="fas fa-sync-alt"></i> Refresh
                </button>
                <a href="/admin/logs/?key=<%= accessKey %>" class="btn btn-success">
                    <i class="fas fa-download"></i> Download
                </a>
                <a href="/admin/users/view?key=<%= accessKey %>" class="btn btn-primary">
                    <i class="fas fa-users"></i> Users
                </a>
            </div>
            <div>
                <button class="btn btn-danger" onclick="clearLogs()">
                    <i class="fas fa-trash"></i> Clear Logs
                </button>
            </div>
        </div>
        
        <div class="logs-container" id="logsContainer">
            <div class="loading">
                <div class="spinner"></div>
                <p>Loading logs...</p>
            </div>
        </div>
    </div>

    <script>
        let autoRefresh = true;
        const accessKey = '<%= accessKey %>';
        
        async function loadLogs() {
            try {
                const response = await fetch(`/admin/logs/json?key=${accessKey}`);
                
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                
                const data = await response.json();
                
                // Update stats
                document.getElementById('totalLogs').textContent = data.stats.total;
                document.getElementById('todayLogs').textContent = data.stats.today;
                document.getElementById('activeUsers').textContent = data.stats.activeUsers || 0;
                
                // Update logs
                const container = document.getElementById('logsContainer');
                
                if (data.logs.length === 0) {
                    container.innerHTML = `
                        <div class="empty-state">
                            <i class="fas fa-inbox"></i>
                            <h3>No logs yet</h3>
                            <p>Logs will appear here once users start interacting with the bot.</p>
                        </div>
                    `;
                    return;
                }
                
                container.innerHTML = data.logs.map(log => `
                    <div class="log-entry">
                        <div class="log-header">
                            <span class="log-user">${escapeHtml(log.user)}</span>
                            <div>
                                <span class="log-model">${escapeHtml(log.model)}</span>
                                <span class="log-time">${escapeHtml(log.time)}</span>
                            </div>
                        </div>
                        <div class="log-message">
                            <strong>User:</strong> ${escapeHtml(log.userMessage.substring(0, 200))}${log.userMessage.length > 200 ? '...' : ''}
                        </div>
                        <div class="log-response">
                            <strong>Bot:</strong> ${escapeHtml(log.botMessage.substring(0, 300))}${log.botMessage.length > 300 ? '...' : ''}
                        </div>
                    </div>
                `).join('');
                
            } catch (error) {
                console.error('Error loading logs:', error);
                document.getElementById('logsContainer').innerHTML = `
                    <div class="error">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>Error loading logs:</strong> ${error.message}
                    </div>
                `;
            }
        }
        
        async function clearLogs() {
            if (!confirm('Are you sure you want to clear all logs? This cannot be undone.')) {
                return;
            }
            
            try {
                const response = await fetch(`/admin/logs/clear?key=${accessKey}`, {
                    method: 'POST'
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert('Logs cleared successfully!');
                    await loadLogs();
                } else {
                    alert('Error: ' + result.error);
                }
            } catch (error) {
                alert('Error clearing logs: ' + error.message);
            }
        }
        
        function refreshLogs() {
            loadLogs();
        }
        
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
        
        // Auto refresh every 30 seconds
        // setInterval(() => {
        //     if (autoRefresh) {
        //         loadLogs();
        //     }
        // }, 60000);
        
        // Load logs on page load
        loadLogs();
    </script>
</body>
</html>