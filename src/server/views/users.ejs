<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SorhyAI Bot - Users Dashboard</title>
    <!-- Favicon -->
    <link rel="shortcut icon" href="/assets/SorhyAI_favicon.png" type="image/x-icon">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- CSS Link -->
    <link rel="stylesheet" href="/css/users.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <h1><i class="fas fa-users"></i> Sorhy Bot Users</h1>
            <p>User Management Dashboard</p>
        </div>
        
        <div class="stats-grid">
            <div class="stat-card users">
                <div class="stat-number" id="totalUsers">-</div>
                <div class="stat-label">Total Users</div>
            </div>
            <div class="stat-card messages">
                <div class="stat-number" id="totalMessages">-</div>
                <div class="stat-label">Total Messages</div>
            </div>
            <div class="stat-card cached">
                <div class="stat-number" id="cachedUsers">-</div>
                <div class="stat-label">Cached Users</div>
            </div>
            <div class="stat-card queued">
                <div class="stat-number" id="queuedSaves">-</div>
                <div class="stat-label">Queued Saves</div>
            </div>
        </div>
        
        <div class="controls">
            <div>
                <button class="btn btn-primary" onclick="refreshUsers()">
                    <i class="fas fa-sync-alt"></i> Refresh
                </button>
                <a href="/admin/users/export?key=<%= accessKey %>" class="btn btn-success">
                    <i class="fas fa-download"></i> Export
                </a>
                <a href="/admin/logs/view?key=<%= accessKey %>" class="btn btn-primary">
                    <i class="fas fa-list"></i> Logs
                </a>
            </div>
            <div>
                <input type="text" class="search-box" placeholder="Search users..." id="searchBox">
                <button class="btn btn-danger" onclick="clearAllUsers()">
                    <i class="fas fa-trash"></i> Clear All
                </button>
            </div>
        </div>

        <div class="filters">
            <div class="filter-group">
                <label for="limitSelect">Show:</label>
                <select id="limitSelect" class="card" onchange="changeLimit()">
                    <option value="10">10 per page</option>
                    <option value="25" selected>25 per page</option>
                    <option value="50">50 per page</option>
                    <option value="100">100 per page</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="sortSelect">Sort by:</label>
                <select id="sortSelect" class="card" onchange="changeSort()">
                    <option value="lastActivity">Last Activity</option>
                    <option value="createdAt">Created Date</option>
                    <option value="chatId">User ID</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="orderSelect">Order:</label>
                <select id="orderSelect" class="card" onchange="changeSort()">
                    <option value="desc">Newest First</option>
                    <option value="asc">Oldest First</option>
                </select>
            </div>
        </div>
        
        <div class="users-container" id="usersContainer">
            <div class="loading">
                <div class="spinner"></div>
                <p>Loading users...</p>
            </div>
        </div>

        <div class="pagination" id="pagination" style="display: none;">
            <button id="firstBtn" onclick="goToPage(1)">
                <i class="fas fa-angle-double-left"></i>
            </button>
            <button id="prevBtn" onclick="goToPage(currentPage - 1)">
                <i class="fas fa-angle-left"></i>
            </button>
            <div id="pageButtons"></div>
            <button id="nextBtn" onclick="goToPage(currentPage + 1)">
                <i class="fas fa-angle-right"></i>
            </button>
            <button id="lastBtn" onclick="goToPage(totalPages)">
                <i class="fas fa-angle-double-right"></i>
            </button>
            <div class="pagination-info" id="paginationInfo"></div>
        </div>
    </div>

    <div class="loading-overlay" id="loadingOverlay" style="display: none;">
        <div class="spinner"></div>
    </div>

    <script>
        let currentPage = 1;
        let totalPages = 1;
        let totalCount = 0;
        let currentLimit = 25;
        let currentSort = 'lastActivity';
        let currentOrder = 'desc';
        let searchTimeout = null;

        // Models
        const MODEL_LITE = 'meta-llama/llama-3.3-70b-instruct:free';
        const MODEL_PRO = 'google/gemma-3-27b-it:free';
        const MODEL_X = 'moonshotai/kimi-k2:free';
        
        const accessKey = '<%= accessKey %>';
        
        async function loadUsers(showOverlay = false) {
            try {
                if (showOverlay) {
                    document.getElementById('loadingOverlay').style.display = 'flex';
                }

                const searchTerm = document.getElementById('searchBox').value.trim();
                const params = new URLSearchParams({
                    key: accessKey,
                    page: currentPage,
                    limit: currentLimit,
                    sortBy: currentSort,
                    sortOrder: currentOrder
                });

                if (searchTerm) {
                    params.append('search', searchTerm);
                }
                
                const response = await fetch(`/admin/users/data?${params}`);
                
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                
                const data = await response.json();
                
                // Update pagination info
                currentPage = data.pagination.currentPage;
                totalPages = data.pagination.totalPages;
                totalCount = data.pagination.totalCount;
                
                // Update stats
                document.getElementById('totalUsers').textContent = data.stats.totalUsers || 0;
                document.getElementById('totalMessages').textContent = data.stats.totalMessages || 0;
                document.getElementById('cachedUsers').textContent = data.stats.cachedUsers || 0;
                document.getElementById('queuedSaves').textContent = data.stats.queuedSaves || 0;
                
                displayUsers(data.users || []);
                updatePagination();
                
            } catch (error) {
                console.error('Error loading users:', error);
                document.getElementById('usersContainer').innerHTML = `
                    <div class="error">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>Error loading users:</strong> ${error.message}
                    </div>
                `;
            } finally {
                document.getElementById('loadingOverlay').style.display = 'none';
            }
        }
        
        function displayUsers(users) {
            const container = document.getElementById('usersContainer');
            
            if (users.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-user-slash"></i>
                        <h3>No users found</h3>
                        <p>No users match your current search criteria.</p>
                    </div>
                `;
                return;
            }
            
            container.innerHTML = users.map(user => `
                <div class="user-card" data-user-id="${user.id}">
                    <div class="user-header" onclick="toggleUserDetails('${user.id}')">
                        <div class="user-info">
                            <span class="user-id">${escapeHtml(user.username || user.id)}</span>
                            <span class="user-badge badge-model">${escapeHtml(user.model === MODEL_LITE ? 'Model Lite' : user.model === MODEL_PRO ? 'Model Pro' : user.model === MODEL_X ? 'Model X' : 'Unknown')}</span>
                            <span class="user-badge badge-language">${escapeHtml(user.language || 'en').toUpperCase()}</span>
                        </div>
                        <div class="user-stats">
                            <span><i class="fas fa-comments"></i> ${user.messages?.length || 0} messages</span>
                            <span><i class="fas fa-clock"></i> ${formatDate(user.lastActivity)}</span>
                            <i class="fas fa-chevron-down toggle-icon" id="toggle-${user.id}"></i>
                        </div>
                    </div>
                    <div class="user-details" id="details-${user.id}">
                        <div class="detail-grid">
                            <div class="detail-item">
                                <div class="detail-label">Created At</div>
                                <div class="detail-value">${formatDate(user.createdAt)}</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">Last Activity</div>
                                <div class="detail-value">${formatDate(user.lastActivity)}</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">Language</div>
                                <div class="detail-value">${escapeHtml(user.language || 'en').toUpperCase()}</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">Model</div>
                                <div class="detail-value">${escapeHtml(user.model === MODEL_LITE ? 'Model Lite' : user.model === MODEL_PRO ? 'Model Pro' : user.model === MODEL_X ? 'Model X' : 'Unknown')}</div>
                            </div>
                        </div>
                        ${user.messages && user.messages.length > 0 ? `
                        <div class="messages-preview">
                            <h4 style="margin-bottom: 15px; color: #333;">
                                <i class="fas fa-comments"></i> Recent Messages (${user.messages.length})
                            </h4>
                            ${user.messages.slice(-5).map(msg => `
                                <div class="message-item">
                                    <div class="message-user">
                                        <strong>User:</strong> ${escapeHtml(msg.userMessage.substring(0, 150))}${msg.userMessage.length > 150 ? '...' : ''}
                                    </div>
                                    <div class="message-bot">
                                        <strong>Bot:</strong> ${escapeHtml(msg.assistantMessage.substring(0, 150))}${msg.assistantMessage.length > 150 ? '...' : ''}
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                        ` : '<p style="color: #666; font-style: italic;">No messages yet</p>'}
                    </div>
                </div>
            `).join('');
        }

        function updatePagination() {
            const pagination = document.getElementById('pagination');
            const pageButtons = document.getElementById('pageButtons');
            const paginationInfo = document.getElementById('paginationInfo');
            
            if (totalPages <= 1) {
                pagination.style.display = 'none';
                return;
            }
            
            pagination.style.display = 'flex';
            
            // Update navigation buttons
            document.getElementById('firstBtn').disabled = currentPage === 1;
            document.getElementById('prevBtn').disabled = currentPage === 1;
            document.getElementById('nextBtn').disabled = currentPage === totalPages;
            document.getElementById('lastBtn').disabled = currentPage === totalPages;
            
            // Generate page buttons
            let pageButtonsHTML = '';
            const maxVisiblePages = 5;
            let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
            let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
            
            if (endPage - startPage + 1 < maxVisiblePages) {
                startPage = Math.max(1, endPage - maxVisiblePages + 1);
            }
            
            for (let i = startPage; i <= endPage; i++) {
                pageButtonsHTML += `
                    <button class="${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">
                        ${i}
                    </button>
                `;
            }
            
            pageButtons.innerHTML = pageButtonsHTML;
            
            // Update pagination info
            const start = (currentPage - 1) * currentLimit + 1;
            const end = Math.min(currentPage * currentLimit, totalCount);
            paginationInfo.textContent = `Showing ${start}-${end} of ${totalCount} users`;
        }

        function goToPage(page) {
            if (page >= 1 && page <= totalPages && page !== currentPage) {
                currentPage = page;
                loadUsers(true);
            }
        }

        function changeLimit() {
            currentLimit = parseInt(document.getElementById('limitSelect').value);
            currentPage = 1; // Reset to first page
            loadUsers(true);
        }

        function changeSort() {
            currentSort = document.getElementById('sortSelect').value;
            currentOrder = document.getElementById('orderSelect').value;
            currentPage = 1; // Reset to first page
            loadUsers(true);
        }

        // Search functionality with debouncing
        document.getElementById('searchBox').addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                currentPage = 1; // Reset to first page when searching
                loadUsers(true);
            }, 500);
        });
        
        function toggleUserDetails(userId) {
            const details = document.getElementById(`details-${userId}`);
            const icon = document.getElementById(`toggle-${userId}`);
            
            if (details.classList.contains('show')) {
                details.classList.remove('show');
                icon.classList.remove('fa-chevron-up');
                icon.classList.add('fa-chevron-down');
            } else {
                details.classList.add('show');
                icon.classList.remove('fa-chevron-down');
                icon.classList.add('fa-chevron-up');
            }
        }
        
        async function clearAllUsers() {
            if (!confirm('Are you sure you want to delete ALL user data? This cannot be undone!')) {
                return;
            }
            
            if (!confirm('This will permanently delete all users and their conversation history. Are you absolutely sure?')) {
                return;
            }
            
            try {
                document.getElementById('loadingOverlay').style.display = 'flex';
                
                const response = await fetch(`/admin/users/clear?key=${accessKey}`, {
                    method: 'POST'
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert(`Successfully deleted ${result.deletedUsers} users!`);
                    currentPage = 1;
                    await loadUsers();
                } else {
                    alert('Error: ' + result.error);
                }
            } catch (error) {
                alert('Error clearing users: ' + error.message);
            } finally {
                document.getElementById('loadingOverlay').style.display = 'none';
            }
        }
        
        function refreshUsers() {
            loadUsers(true);
        }
        
        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
        
        function formatDate(timestamp) {
            if (!timestamp) return 'Unknown';
            const date = new Date(timestamp);
            return date.toLocaleString();
        }
        
        // Auto refresh every 60 seconds
        setInterval(() => {
            loadUsers(false); // Don't show overlay for auto refresh
        }, 60000);
        
        // Load users on page load
        loadUsers();
    </script>
</body>
</html>